{
    "name": "tobento/app-testing",
    "version": "2.0.8",
    "type": "library",
    "description": "App testing support.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "testing",
        "tests"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-console": "^2.0",
        "tobento/app-seeding": "^2.0",
        "tobento/service-collection": "^2.0",
        "tobento/service-iterable": "^2.0",
        "tobento/service-macro": "^2.0",
        "tobento/service-support": "^2.0",
        "mockery/mockery": "^1.6",
        "nyholm/psr7": "^1.8",
        "symfony/mime": "^7.3",
        "symfony/dom-crawler": "^7.3",
        "symfony/css-selector": "^7.3",
        "symfony/var-dumper": "^7.3"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-event": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-view": "^2.0",
        "tobento/app-queue": "^2.0",
        "tobento/app-mail": "^2.0",
        "tobento/app-notifier": "^2.0",
        "tobento/app-file-storage": "^2.0",
        "tobento/app-logging": "^2.0",
        "tobento/app-database": "^2.0",
        "tobento/app-user": "^2.0",
        "tobento/app-translation": "^2.0",
        "tobento/app-language": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Testing\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Testing\\Test\\": "tests",
            "Tobento\\App\\Event\\Test\\": "vendor/tobento/app-event/tests",
            "Tobento\\Service\\Event\\Test\\": "vendor/tobento/service-event/tests",
            "Tobento\\Service\\Queue\\Test\\": "vendor/tobento/service-queue/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}